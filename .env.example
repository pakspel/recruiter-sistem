# Discord Bot
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
GUILD_ID=your_guild_id_here

# Web API Secret
API_KEY=your_secret_key_here

# Admin Role ID (Discord role that can use admin commands)
ADMIN_ROLE_ID=

# SQLite database path
# На Railway: создай Volume, примонтируй к /data, и укажи /data/recruiter.db
DATA_PATH=./data.db

# Port (Railway auto-sets this, не трогай)
PORT=3000
